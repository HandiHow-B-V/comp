# Public deployment addresses; set both domains and URLs consistently.
APP_DOMAIN=comp.example.com
API_DOMAIN=api.comp.example.com
APP_URL=https://comp.example.com
API_URL=https://api.comp.example.com
# Portal is deployed separately; this Compose stack does not run a portal.
PORTAL_URL=https://portal.example.com
ACME_EMAIL=admin@example.com
COMP_IMAGE_TAG=local

POSTGRES_DB=comp
POSTGRES_USER=comp
POSTGRES_PASSWORD=

# Generate separate random values before first use. Preserve existing values on upgrades.
AUTH_SECRET=
SECRET_KEY=
BETTER_AUTH_SECRET=
REVALIDATION_SECRET=
ENCRYPTION_KEY=
SERVICE_TOKEN_TRIGGER=
SERVICE_TOKEN_PORTAL=

# Brevo is selected when its key is set; otherwise Resend is used.
EMAIL_DELIVERY_MODE=direct
BREVO_API_KEY=
BREVO_FROM_DEFAULT=
BREVO_FROM_SYSTEM=
BREVO_FROM_MARKETING=
BREVO_FROM_TRUST_PORTAL=
BREVO_REPLY_TO_MARKETING=
BREVO_TO_TEST=
RESEND_API_KEY=
RESEND_FROM_DEFAULT=
RESEND_FROM_SYSTEM=

# S3-compatible object storage. Keep the existing credentials and bucket names.
APP_AWS_ENDPOINT=https://fsn1.your-objectstorage.com
APP_AWS_REGION=eu-central
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_BUCKET_NAME=
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET=
APP_AWS_KNOWLEDGE_BASE_BUCKET=
APP_AWS_ORG_ASSETS_BUCKET=

# Optional features; omit unconfigured services instead of inventing credentials.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
MACED_API_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=
AUTH_TRUSTED_ORIGINS=https://comp.example.com,https://api.comp.example.com

# Small-host build settings: run the separate typecheck successfully first.
BUILD_MEMORY_LIMIT_MB=3072
SKIP_NEXT_TYPECHECK=true
